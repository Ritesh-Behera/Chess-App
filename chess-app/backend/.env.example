# Server
PORT=4000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=change-this-to-a-long-random-string

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must be: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Comma-separated emails that should automatically become admins on first login.
# Leave blank and promote users manually from the admin panel instead.
ADMIN_EMAILS=you@example.com
